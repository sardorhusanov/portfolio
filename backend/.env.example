APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

TELEGRAM_BOT_TOKEN=
# @channelusername or numeric -100... channel ID
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=

UPLOAD_DIR=uploads
MAX_IMAGE_UPLOAD_MB=10
# Tests require an isolated PostgreSQL database (never your content database).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio_test
# Optional one-time admin initialization environment variables (do not commit credentials):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
